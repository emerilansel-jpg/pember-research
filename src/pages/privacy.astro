---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy Policy | Pember Research" description="Privacy Policy — Pember Research" noindex={true}>
  <section class="page-hero">
    <div class="container">
      <h1 style="color:#fff;">Privacy Policy</h1>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:800px;">
      <p>Pember Research is committed to protecting your privacy. We collect information through forms and newsletter subscriptions, and automatically through analytics. We do not sell personal data to third parties.</p><p>For privacy inquiries: <a href="mailto:privacy@pemberresearch.com">privacy@pemberresearch.com</a></p>
    </div>
  </section>
</BaseLayout>
