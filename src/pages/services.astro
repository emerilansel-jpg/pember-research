---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Services | Pember Research" description="Services — Pember Research">
  <section class="page-hero">
    <div class="container">
      <h1 style="color:#fff;">Services</h1>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:800px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;margin-top:1.5rem;"><div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;"><h3>Market Intelligence</h3><p style="color:var(--text-secondary);font-size:0.9rem;">Comprehensive sector reports and market analysis.</p></div><div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;"><h3>Due Diligence</h3><p style="color:var(--text-secondary);font-size:0.9rem;">Technical and commercial due diligence for M&A.</p></div><div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;"><h3>Custom Research</h3><p style="color:var(--text-secondary);font-size:0.9rem;">Bespoke research programs for strategic questions.</p></div><div style="background:var(--bg-soft);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;"><h3>Advisory</h3><p style="color:var(--text-secondary);font-size:0.9rem;">Ongoing strategic advisory and monitoring.</p></div></div>
    </div>
  </section>
</BaseLayout>
