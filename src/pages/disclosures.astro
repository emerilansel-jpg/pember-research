---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Disclosures | Pember Research" description="Disclosures — Pember Research" noindex={true}>
  <section class="page-hero">
    <div class="container">
      <h1 style="color:#fff;">Disclosures</h1>
    </div>
  </section>
  <section class="section">
    <div class="container" style="max-width:800px;">
      <p>Pember Research maintains strict editorial independence. We do not accept sponsorship, paid placement, or consulting fees from companies we cover. Analysts are prohibited from holding financial positions in covered publicly traded companies.</p>
    </div>
  </section>
</BaseLayout>
