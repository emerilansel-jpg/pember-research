---
const navItems = [
  { label: 'Research', href: '/research' },
  { label: 'Insights', href: '/insights' },
  { label: 'Services', href: '/services' },
  { label: 'Methodology', href: '/methodology' },
  { label: 'Team', href: '/team' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
const { pathname } = Astro.url;
---

<header class="site-header" role="banner">
  <div class="site-header__topbar">
    <div class="site-header__topbar-inner">
      <span class="site-header__topbar-item"><span class="pulse-dot pulse-dot--green"></span> Supply Chain & Logistics Intelligence</span>
      <span class="site-header__topbar-item">research@pemberresearch.com</span>
    </div>
  </div>
  <div class="site-header__main">
    <div class="site-header__inner">
      <a href="/" class="site-header__logo">PEMBER <span>/ RESEARCH</span></a>
      <nav class="site-header__nav" id="main-nav">
        {navItems.map(item => (
          <a href={item.href} class="site-header__nav-link" aria-current={pathname === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="site-header__actions">
        <a href="/contact" class="btn site-header__cta">Request a Brief</a>
        <button class="site-header__toggle" id="nav-toggle" aria-label="Toggle navigation">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
    toggle.classList.toggle('open');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { nav?.classList.remove('open'); toggle?.classList.remove('open'); }
  });
</script>

<style>
  .site-header__topbar {
    background: var(--navy);
    color: rgba(255,255,255,0.8);
    font-size: 0.8rem;
    padding: 0.4rem 0;
  }
  .site-header__topbar-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .site-header__topbar-item { display: flex; align-items: center; gap: 6px; }
  .site-header__main {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .site-header__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }
  .site-header__logo {
    font-family: var(--font-heading, system-ui);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--navy);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .site-header__logo span { font-weight: 400; opacity: 0.6; font-size: 0.8rem; }
  .site-header__nav { display: flex; gap: 1.25rem; align-items: center; }
  .site-header__nav-link {
    color: var(--text-body);
    font-weight: 500;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 0.16s ease;
  }
  .site-header__nav-link:hover, .site-header__nav-link[aria-current="page"] { color: var(--accent); }
  .site-header__cta { padding: 0.45rem 1.1rem !important; font-size: 0.8rem; }
  .site-header__toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .site-header__toggle span { display: block; width: 22px; height: 2px; background: var(--navy); transition: transform 0.2s; }
  .pulse-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #22c55e; animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.7)} }
  @media (max-width: 768px) {
    .site-header__toggle { display: flex; }
    .site-header__nav {
      display: none;
      position: absolute;
      top: 100%; left: 0; right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      padding: 1rem 1.5rem;
      gap: 0.75rem;
    }
    .site-header__nav.open { display: flex; }
    .site-header__actions .btn { display: none; }
  }
</style>
